/* ==========================================
 * ROFI — dmenu-only config
 * Used for: cliphist, wallpaper selector, RGB selector, power profile
 * App launching is handled by fuzzel.
 * Install: yay -S rofi-wayland
 * ========================================== */

configuration {
    modi: "drun,dmenu,window";
    show-icons: true;
    display-dmenu: "  Run";
    display-window: "  Windows";
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    /* Disable drun — fuzzel handles that */
    drun-categories: "";
}

* {
    bg:          #11111bdd;
    bg-alt:      #1e1e2e99;
    bg-hover:    #313244cc;
    fg:          #cdd6f4;
    fg-dim:      #a6adc8;
    cyan:        #00ffff;
    cyan-dim:    #00ffff55;
    border-col:  #00ffff66;

    font:             "CaskaydiaCove Nerd Font 12";
    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

/* ── Main window ───────────────────────── */
window {
    width:            620px;
    border:           2px solid;
    border-color:     @border-col;
    border-radius:    16px;
    background-color: @bg;
    padding:          16px;
}

mainbox {
    background-color: transparent;
    spacing: 14px;
}

/* ── Search bar ────────────────────────── */
inputbar {
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          13px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:  @cyan;
    font:        "CaskaydiaCove Nerd Font Bold 13";
    vertical-align: 0.5;
}

entry {
    placeholder-color: @fg-dim;
    text-color:        @fg;
    vertical-align:    0.5;
}

/* ── List ──────────────────────────────── */
listview {
    background-color: transparent;
    columns: 1;
    lines:   8;
    spacing: 4px;
    scrollbar: false;
    padding: 4px 0 0;
    fixed-height: true;
}

element {
    padding:          9px 12px;
    border-radius:    10px;
    background-color: transparent;
    spacing:          12px;
}

element normal normal,
element alternate normal {
    text-color:       @fg;
    background-color: transparent;
}

element selected normal {
    background-color: @bg-hover;
    text-color:       @cyan;
    border:           1px solid;
    border-color:     @border-col;
}

element-icon {
    size:             26px;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
    background-color: transparent;
}
